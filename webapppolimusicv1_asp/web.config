<?xml version="1.0" encoding="utf-8"?>
<!--
    PoliMusic - Configuracion de IIS para la aplicacion ASP clasico.
    Requiere que la aplicacion se ejecute en un Application Pool
    con "No Managed Code" y que la caracteristica "ASP" este instalada.
-->
<configuration>
    <system.webServer>

        <defaultDocument>
            <files>
                <clear />
                <add value="Default.asp" />
            </files>
        </defaultDocument>

        <!-- ASP clasico: buffer activo y errores detallados en desarrollo -->
        <asp bufferingOn="true"
             scriptErrorSentToBrowser="true"
             enableParentPaths="false"
             errorsToNTLog="false"
             codePage="65001"
             scriptLanguage="VBScript" />

        <!-- Necesario para que IIS sirva los audios del reproductor -->
        <staticContent>
            <remove fileExtension=".mp3" />
            <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
            <remove fileExtension=".m4a" />
            <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
        </staticContent>

        <!-- Sin cache agresivo para los .asp -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>
</configuration>
